APP_ENV=development
APP_NAME=My SaaS
PUBLIC_APP_URL=http://localhost:8787
CANONICAL_HOST=
UNIT_PRICE_CENTS=100
PAYMENT_PROVIDER=stripe

# Better Auth and Google OAuth. Generate the secret with: openssl rand -base64 32
# Google redirect URI: <origin>/api/auth/callback/google
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma separated bootstrap administrators. These addresses always resolve to the admin role.
ADMIN_EMAILS=

# Transactional email. Pick one provider and leave the others empty.
# Without a provider the template disables verification, reset and magic link safely.
EMAIL_PROVIDER=resend
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Cloudflare Turnstile. Both values are required before any challenge is enforced.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set to true only for local load testing.
RATE_LIMIT_DISABLED=false

STRIPE_API_BASE=https://api.stripe.com
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRODUCT_ID=prod_replace_me
STRIPE_PORTAL_CONFIGURATION_ID=

POLAR_API_BASE=https://sandbox-api.polar.sh
POLAR_ACCESS_TOKEN=polar_oat_replace_me
POLAR_WEBHOOK_SECRET=polar_whs_replace_me
POLAR_PRODUCT_ID=replace_with_product_uuid

CREEM_API_BASE=https://test-api.creem.io
CREEM_API_KEY=creem_test_replace_me
CREEM_WEBHOOK_SECRET=replace_me
CREEM_PRODUCT_ID=prod_replace_me

# Waffo Pancake。私钥来自 API 与开发中的测试 API Key，勿提交到仓库。
# 商品可通过 npm run waffo:setup 初始化，或使用控制台已有的商品 ID。
WAFFO_ENVIRONMENT=test
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_PRIVATE_KEY=
WAFFO_PRODUCT_ID=
