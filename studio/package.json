{
  "name": "ai-costume-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "dev": "vite",
    "dev:worker": "wrangler dev --persist-to=.wrangler/state",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create ai-costume-studio-db",
    "db:migrate:local": "wrangler d1 migrations apply ai-costume-studio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ai-costume-studio-db --remote",
    "seed": "node scripts/seed.mjs",
    "seed:remote": "node scripts/seed.mjs --remote",
    "waffo:setup": "node scripts/setup-waffo.mjs",
    "brand": "node scripts/make-brand.mjs",
    "init": "node scripts/init-project.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@waffo/pancake-ts": "^0.26.0",
    "better-auth": "^1.7.1",
    "hono": "^4.13.3",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.32.0"
  }
}
