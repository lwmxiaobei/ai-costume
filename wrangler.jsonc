{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-costume-zh",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/media/*", "/download/*"]
  },
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "ai-costume-images", "remote": true }]
}
